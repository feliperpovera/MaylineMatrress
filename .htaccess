DirectoryIndex index.html

RewriteEngine On
# Canonical host is https://maylinmattress.com (no www), matching server.js.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteRule ^private(/|$) - [F,L]
RewriteRule ^portal/?$ portal.html [L]
RewriteRule ^gracias/?$ gracias.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^pillow-top-mattress-hialeah/?$ pillow-top-mattress-hialeah.html [L]
RewriteRule ^luxury-mattress-hialeah/?$ luxury-mattress-hialeah.html [L]
RewriteRule ^custom-mattress/?$ custom-mattress.html [L]
RewriteRule ^boat-rv-mattress/?$ boat-rv-mattress.html [L]
RewriteRule ^hotel-supply/?$ hotel-supply.html [L]
RewriteRule ^spring-mattress/?$ spring-mattress.html [L]
RewriteRule ^high-density-foam-mattress/?$ high-density-foam-mattress.html [L]
RewriteRule ^latex-mattress/?$ latex-mattress.html [L]
RewriteRule ^custom-carpentry/?$ custom-carpentry.html [L]
RewriteRule ^why-maylin/?$ why-maylin.html [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^blog/?$ blog.html [L]
RewriteRule ^blog/how-to-measure-for-a-custom-mattress/?$ blog-how-to-measure-for-a-custom-mattress.html [L]
RewriteRule ^blog/boat-mattress-template-guide/?$ blog-boat-mattress-template-guide.html [L]
RewriteRule ^blog/why-factory-direct-mattresses-cost-less/?$ blog-why-factory-direct-mattresses-cost-less.html [L]
RewriteRule ^blog/mattress-sizes-explained/?$ blog-mattress-sizes-explained.html [L]
RewriteRule ^es/medidas-de-colchones/?$ medidas-de-colchones.html [L]
RewriteRule ^es/?$ es.html [L]
RewriteRule ^en/?$ / [R=301,L]
