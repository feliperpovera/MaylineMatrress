DirectoryIndex index.html

RewriteEngine On
# Canonical host is https://maylinmattress.com (no www), matching server.js.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteRule ^private(/|$) - [F,L]
RewriteRule ^portal/?$ portal.html [L]
RewriteRule ^gracias/?$ gracias.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^es/?$ es.html [L]
RewriteRule ^pillow-top-mattress-hialeah/?$ pillow-top-mattress-hialeah.html [L]
RewriteRule ^luxury-mattress-hialeah/?$ luxury-mattress-hialeah.html [L]
RewriteRule ^en/?$ / [R=301,L]
